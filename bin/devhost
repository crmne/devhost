#!/usr/bin/env bash
# devhost: stable https://<name>.localhost URLs for local dev servers, served by Caddy.
#
# Routes live as one file per host in $DEVHOST_CONFIG_DIR/routes. Every change
# regenerates the Caddyfile and reloads Caddy through its admin socket, so the
# routes survive restarts and reboots.
set -euo pipefail

CONFIG_DIR="${DEVHOST_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/devhost}"
ROUTES_DIR="$CONFIG_DIR/routes"
CADDYFILE="$CONFIG_DIR/Caddyfile"
ADMIN_SOCKET="${DEVHOST_ADMIN_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/devhost/admin.sock}"
HTTP_PORT="${DEVHOST_HTTP_PORT:-80}"
HTTPS_PORT="${DEVHOST_HTTPS_PORT:-443}"
CADDY="${DEVHOST_CADDY:-caddy}"
DEVHOST_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/caddy/pki/authorities/local/root.crt"
NSS_DB="sql:$HOME/.pki/nssdb"
NSS_NICKNAME="devhost Caddy Local Authority"

usage() {
  cat <<'EOF'
Usage:
  devhost add NAME PORT            Route https://NAME.localhost to localhost:PORT
  devhost rm NAME                  Remove a route
  devhost ls                       List routes and whether their app is up
  devhost run [-n NAME] [-p PORT] [--] COMMAND...
                                   Pick a port, route NAME to it, export PORT and
                                   DEVHOST_URL, then exec COMMAND. NAME defaults to
                                   the git repository; linked worktrees and
                                   subdirectories become subdomains
                                   (fix-ui.NAME, docs.NAME). PORT defaults to
                                   $PORT, then to a stable free port for NAME.
                                   `jekyll serve` gets --port and a plugin that
                                   sets site.url to the devhost URL.
  devhost url [NAME]               Print the URL devhost run would use here
  devhost doctor                   Check Caddy, ports, and certificate trust
  devhost trust                    Trust the Caddy CA in your Chromium/NSS database
  devhost render                   Write the Caddyfile without reloading
  devhost reload                   Write the Caddyfile and reload Caddy

Examples:
  devhost add chatwithwork 3000
  devhost run -- bin/dev
  devhost run -n rubyllm-docs -- bundle exec jekyll serve
EOF
}

die() { echo "devhost: $*" >&2; exit 1; }

# "Chat_With.Work" -> "chat-with.work.localhost"; "docs.localhost" stays as it is.
host_for() {
  local name
  name="$(printf '%s' "$1" | tr '[:upper:]_' '[:lower:]-')"
  name="${name%.localhost}"
  [[ "$name" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$ ]] ||
    die "invalid name: $1"
  printf '%s.localhost' "$name"
}

upstream_for() {
  if [[ "$1" =~ ^[0-9]+$ ]]; then
    ((1 <= $1 && $1 <= 65535)) || die "invalid port: $1"
    printf 'localhost:%s' "$1"
  elif [[ "$1" =~ ^[A-Za-z0-9.:\[\]-]+:[0-9]+$ ]]; then
    printf '%s' "$1"
  else
    die "invalid port: $1"
  fi
}

render() {
  mkdir -p "$ROUTES_DIR"
  local tmp route host
  tmp="$(mktemp "$CADDYFILE.XXXXXX")"
  {
    echo "# Generated by devhost from $ROUTES_DIR. Use devhost add/rm instead of editing."
    echo "{"
    echo "	admin unix/$ADMIN_SOCKET"
    echo "	default_bind 127.0.0.1 [::1]"
    echo "	http_port $HTTP_PORT"
    echo "	https_port $HTTPS_PORT"
    echo "	local_certs"
    echo "	skip_install_trust"
    echo "	persist_config off"
    echo "}"
    for route in "$ROUTES_DIR"/*; do
      [[ -f "$route" ]] || continue
      host="$(basename -- "$route")"
      echo
      echo "$host {"
      echo "	reverse_proxy $(<"$route")"
      echo "}"
    done
  } >"$tmp"
  mv "$tmp" "$CADDYFILE"
}

reload() {
  render
  if [[ -S "$ADMIN_SOCKET" ]]; then
    "$CADDY" reload --config "$CADDYFILE" --adapter caddyfile --address "unix/$ADMIN_SOCKET" 2>/dev/null ||
      echo "devhost: Caddy did not accept the new config; see journalctl --user -u devhost" >&2
  else
    echo "devhost: Caddy is not running; start it with: systemctl --user start devhost" >&2
  fi
}

add() {
  (($# == 2)) || die "usage: devhost add NAME PORT"
  local host upstream route
  host="$(host_for "$1")"
  upstream="$(upstream_for "$2")"
  route="$ROUTES_DIR/$host"
  mkdir -p "$ROUTES_DIR"
  if [[ -f "$route" && "$(<"$route")" == "$upstream" ]]; then
    render
  else
    printf '%s\n' "$upstream" >"$route"
    reload
  fi
  echo "https://$host -> $upstream"
}

rm_route() {
  (($# == 1)) || die "usage: devhost rm NAME"
  local host
  host="$(host_for "$1")"
  [[ -f "$ROUTES_DIR/$host" ]] || die "no route for $host"
  rm -f "$ROUTES_DIR/$host"
  reload
}

listening() {
  local port="${1##*:}"
  [[ -n "$(ss -Hltn "sport = :$port" 2>/dev/null)" ]]
}

list() {
  local route upstream state
  for route in "$ROUTES_DIR"/*; do
    [[ -f "$route" ]] || continue
    upstream="$(<"$route")"
    if listening "$upstream"; then state="up"; else state="down"; fi
    printf '%-50s %-20s %s\n' "https://$(basename -- "$route")" "$upstream" "$state"
  done
}

# Project name for the current directory: the repository name, with the worktree
# as a subdomain in a linked git worktree and the directory as a subdomain below
# the repository root. chatwithwork, localhost-https.chatwithwork, docs.archspec.
default_name() {
  local base="${1:-}" top git_dir common_dir
  if top="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    git_dir="$(git rev-parse --absolute-git-dir)"
    common_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
    local named="$base"
    if [[ -z "$base" ]]; then
      if [[ "$(basename "$common_dir")" == ".git" ]]; then
        base="$(basename "$(dirname "$common_dir")")"
      else
        base="$(basename "$top")"
      fi
    fi
    if [[ "$git_dir" != "$common_dir" ]]; then
      base="$(basename "$top").$base"
    fi
    if [[ -z "$named" && "$(pwd -P)" != "$(cd "$top" && pwd -P)" ]]; then
      base="$(basename "$PWD").$base"
    fi
  fi
  printf '%s' "${base:-$(basename "$PWD")}"
}

free_port_for() {
  local host="$1" port offset
  offset=$(($(printf '%s' "$host" | cksum | cut -d' ' -f1) % 1000))
  for ((i = 0; i < 1000; i++)); do
    port=$((4000 + (offset + i) % 1000))
    listening "$port" || { echo "$port"; return; }
  done
  die "no free port between 4000 and 4999"
}

run() {
  local name="" port="${PORT:-}"
  while (($#)); do
    case "$1" in
      -n | --name) name="$2"; shift 2 ;;
      -p | --port) port="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  (($#)) || die "usage: devhost run [-n NAME] [-p PORT] [--] COMMAND..."

  local host
  host="$(host_for "$(default_name "$name")")"
  port="${port:-$(free_port_for "$host")}"
  add "$host" "$port" >/dev/null

  # jekyll serve ignores $PORT and rewrites site.url to http://localhost:PORT,
  # so pass the port and load the plugin that restores the devhost URL.
  local args=("$@") i
  for ((i = 0; i < ${#args[@]} - 1; i++)); do
    if [[ "$(basename -- "${args[i]}")" == "jekyll" && "${args[i + 1]}" =~ ^(serve|server|s)$ ]]; then
      [[ " ${args[*]} " =~ \ (-P|--port)[\ =] ]] || args+=(--port "$port")
      [[ " ${args[*]} " =~ \ (-p|--plugins)[\ =] ]] || args+=(--plugins "$(jekyll_plugins_dir),$DEVHOST_ROOT/jekyll")
      break
    fi
  done

  echo "devhost: https://$host -> localhost:$port" >&2
  export PORT="$port" DEVHOST_URL="https://$host"
  exec "${args[@]}"
}

# The site's own plugins directory, which --plugins would otherwise replace.
jekyll_plugins_dir() {
  local dir=""
  [[ -f _config.yml ]] && dir="$(sed -nE 's/^plugins_dir:[[:space:]]*["'\'']?([^"'\''#]*[^"'\''#[:space:]])["'\'']?.*$/\1/p' _config.yml | head -1)"
  printf '%s' "${dir:-_plugins}"
}

url() {
  echo "https://$(host_for "$(default_name "${1:-}")")"
}

trust_nss() {
  [[ -f "$CA_ROOT" ]] || die "no Caddy CA yet at $CA_ROOT; start devhost first"
  command -v certutil >/dev/null || die "certutil not found (pacman -S nss)"
  mkdir -p "$HOME/.pki/nssdb"
  [[ -f "$HOME/.pki/nssdb/cert9.db" ]] || certutil -N -d "$NSS_DB" --empty-password
  certutil -D -d "$NSS_DB" -n "$NSS_NICKNAME" 2>/dev/null || true
  certutil -A -d "$NSS_DB" -t "C,," -n "$NSS_NICKNAME" -i "$CA_ROOT"
  echo "Trusted $CA_ROOT in $HOME/.pki/nssdb. Restart Chromium to pick it up."
}

check() {
  if eval "$2" >/dev/null 2>&1; then echo "ok    $1"; else echo "FAIL  $1${3:+ ($3)}"; fi
}

doctor() {
  check "caddy is installed" "command -v $CADDY" "run $DEVHOST_ROOT/bin/devhost-system-setup"
  check "unprivileged processes may bind port $HTTP_PORT" \
    "(( \$(sysctl -n net.ipv4.ip_unprivileged_port_start) <= $HTTP_PORT )) || getcap \$(command -v $CADDY) | grep cap_net_bind_service >/dev/null" \
    "run $DEVHOST_ROOT/bin/devhost-system-setup"
  check "devhost service is running" "systemctl --user is-active devhost" "systemctl --user start devhost"
  check "Caddy admin socket exists" "test -S $ADMIN_SOCKET"
  check "Caddy CA exists" "test -f $CA_ROOT"
  check "Caddy CA is in the system trust store" \
    "trust list --filter=ca-anchors | grep 'Caddy Local Authority - [0-9]* ECC Root' >/dev/null" "run $DEVHOST_ROOT/bin/devhost-system-setup"
  check "Caddy CA is in the Chromium NSS database" "certutil -L -d $NSS_DB -n '$NSS_NICKNAME'" "devhost trust"
  check "*.localhost resolves to loopback" "getent hosts devhost-check.localhost | grep -E '^(127\\.|::1)' >/dev/null"
}

command="${1:-help}"
shift || true
case "$command" in
  add) add "$@" ;;
  rm | remove) rm_route "$@" ;;
  ls | list) list ;;
  run) run "$@" ;;
  url) url "$@" ;;
  doctor) doctor ;;
  trust) trust_nss ;;
  render) render ;;
  reload) reload ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 1 ;;
esac
